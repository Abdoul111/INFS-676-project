{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSensitiveObjects",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::cloud-twin-sensitive",
        "arn:aws:s3:::cloud-twin-sensitive/*"
      ]
    }
  ]
}
