{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPublicObjects",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::cloud-twin-public",
        "arn:aws:s3:::cloud-twin-public/*"
      ]
    },
    {
      "Sid": "AllowApiRoleAssumption",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::000000000000:role/cloud-twin-api-role"
    }
  ]
}
